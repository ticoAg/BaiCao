# Compose 依赖服务的本地默认值示例。
# 如果使用 scripts/infisical_env.py 注入环境变量，这个文件通常只在直接运行 docker compose 时才需要。
POSTGRES_PASSWORD=baicao_password
NEO4J_PASSWORD=neo4j_password
OPENAI_API_KEY=your_api_key_here
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
OBJECT_STORAGE_ENDPOINT=localhost:19000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=baicao-pipeline-exports
OBJECT_STORAGE_SECURE=false
