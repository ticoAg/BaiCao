# BaiCao 本地 Infisical 注入示例。
# 用法：
#   cp .env.schema .env
#   然后只填写本机私有的 INFISICAL_TOKEN 或 Universal Auth；
#   其余默认项通常直接沿用仓库中的 infisical.defaults.env 即可。
#   运行时由 scripts/infisical_env.py 通过 HTTP API 注入业务变量。
#
# 仓库运行时会读取 infisical.defaults.env、根目录 .env / .env.local、packages/api/.env。
# DATABASE_URL、OPENAI_API_KEY、NEO4J_PASSWORD 等业务变量可以写在这些 .env 里，
# 也可以放在 Infisical。两边都有时，.env 优先。

# 鉴权二选一：token，或 Universal Auth
INFISICAL_TOKEN=your_service_token
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=

# 常用：需要切换环境时可覆盖，默认一般使用 dev
INFISICAL_ENV=dev

# 可选：当你需要覆盖仓库默认项时再取消注释。
# 当前默认是 Infisical Cloud 项目，secret 路径 /baicao。
# INFISICAL_API_URL=https://app.infisical.com
# INFISICAL_PROJECT_ID=0d879b92-ec1c-4910-855f-30bcbaf10f97
# INFISICAL_SECRET_PATH=/baicao

# 兼容旧脚本口径：仅在你仍使用旧变量名时再启用
# INFISICAL_PATH=/
